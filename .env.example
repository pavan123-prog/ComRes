DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require
AUTH_SECRET=<GENERATE_A_PRIVATE_RANDOM_SECRET>
STRIPE_SECRET_KEY=<STRIPE_TEST_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_TEST_WEBHOOK_SECRET>
BLOB_READ_WRITE_TOKEN=<VERCEL_BLOB_READ_WRITE_TOKEN>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional maintenance/migration settings. Not required to run the application.
NEON_API_KEY=<NEON_API_KEY_FOR_AUTHORIZED_MAINTENANCE>
NEON_PROJECT_ID=<NEON_PROJECT_ID_FOR_AUTHORIZED_MAINTENANCE>
PAYMENT_MIGRATION_EXPECTED_PROJECT_NAME=<AUTHORIZED_NON_PRODUCTION_PROJECT_NAME>
PAYMENT_MIGRATION_EXPECTED_DATABASE=<AUTHORIZED_TEST_DATABASE_NAME>
ALLOW_PAYMENT_MIGRATION=false
